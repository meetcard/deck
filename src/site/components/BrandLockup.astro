---
/**
 * The "Deck / DESIGN SYSTEM" lockup in the page header.
 *
 * Renders the same `deckWordmarkSvg` that Storybook's manager theme uses for
 * its sidebar brand, so the landing page and the docs it links to show one
 * identical logo. This used to be a lookalike rebuilt from three rects plus
 * live text, which is exactly how the two drifted.
 *
 * The wordmark's type is outlined, so the `<svg>` carries no readable text —
 * hence the explicit role/label on the wrapper and `aria-hidden` on the
 * markup itself, leaving one clean accessible name rather than a pile of
 * unlabelled paths.
 */
import { deckWordmarkSvg } from '../../foundations/brand/deckWordmark'
---

<div class="lockup" role="img" aria-label="Deck — Design System">
  <span class="lockup__art" aria-hidden="true" set:html={deckWordmarkSvg} />
</div>

<style>
  .lockup {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lockup__art {
    display: block;
    line-height: 0;
  }

  /* The asset ships width/height attributes; override them so it scales to
     the header rather than pinning itself at its natural 145x52. :global
     because set:html markup never receives Astro's scoping attribute. */
  .lockup__art :global(svg) {
    display: block;
    height: 52px;
    width: auto;
  }

  /* The asset is the "Full Color — Light" variant: its type is baked to Ink
     (#212121) and grey (#595959), which all but disappears on the dark
     background — the same reason .storybook/theme.ts pins the manager to
     base: 'light'. The page has no such escape hatch, so the two type fills
     are remapped onto the semantic text tokens here. The card shapes keep
     their brand greens, which read fine in either scheme.

     This targets the fills by value, so it is coupled to them; deckWordmark's
     test asserts they are still present, and will fail loudly rather than
     letting the wordmark quietly go invisible if the asset is re-exported.

     The real fix is a dark variant of the wordmark from design — at which
     point this block should go away. */
  @media (prefers-color-scheme: dark) {
    .lockup__art :global(svg [fill='#212121']) {
      fill: var(--deck-color-text-default);
    }

    .lockup__art :global(svg [fill='#595959']) {
      fill: var(--deck-color-text-muted);
    }
  }

  @media (max-width: 640px) {
    .lockup__art :global(svg) {
      height: 46px;
    }
  }
</style>
