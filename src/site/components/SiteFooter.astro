---
// Credits, not navigation: these point at the tools Deck is built with, so
// they leave the site. The product's own Storybook is reached from the hero
// CTAs above. https rather than the http:// form — figma.com redirects to
// https anyway, and an http link on an https page is a needless downgrade.
const credits = [
  {
    label: 'Component Library · Built with Storybook',
    href: 'https://storybook.js.org/',
    icon: 'storybook',
  },
  {
    label: 'UI Kit · Designed in Figma',
    href: 'https://figma.com/@meetcard',
    icon: 'figma',
  },
] as const

const year = new Date().getFullYear()
---

<footer class="footer">
  <ul class="footer__credits">
    {
      credits.map((credit) => (
        <li>
          <a class="credit" href={credit.href} target="_blank" rel="noopener noreferrer">
            <svg class="credit__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              {credit.icon === 'storybook' ? (
                <>
                  <path
                    d="M8 1.8 13.4 4.6v6.8L8 14.2 2.6 11.4V4.6L8 1.8Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M8 8.1 13.2 5.4M8 8.1 2.8 5.4M8 8.1v5.9"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                  />
                </>
              ) : (
                <path
                  d="M6.2 1.6h1.7v3.4H6.2a1.7 1.7 0 1 1 0-3.4ZM8 1.6h1.7a1.7 1.7 0 0 1 0 3.4H8V1.6ZM8 5.1h1.7a1.7 1.7 0 0 1 0 3.4H8V5.1ZM6.2 5.1h1.7v3.4H6.2a1.7 1.7 0 0 1 0-3.4ZM6.2 8.6h1.7V12a1.7 1.7 0 1 1-1.7-1.7V8.6Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linejoin="round"
                />
              )}
            </svg>
            {credit.label}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="footer__legal">© {year} MeetCard · Deck Design System</p>
</footer>

<style>
  /* Held to a container rather than the viewport edge, so the chips and the
     legal line sit inside the same gutters as the hero above them. */
  .footer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--deck-space-16);
    width: 100%;
    max-width: 960px;
  }

  .footer__credits {
    display: flex;
    flex-wrap: wrap;
    gap: var(--deck-space-24);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Plain text, not chips: no border, fill, or padding. These are credits
     sitting beside the copyright line, so they should read as the same kind
     of quiet type rather than competing with the hero's buttons. */
  .credit {
    display: inline-flex;
    align-items: center;
    gap: var(--deck-space-8);
    color: var(--deck-color-text-muted);
    font-size: var(--deck-font-size-label-sm);
    text-decoration: none;
    transition: color 150ms ease;
  }

  /* Underline only on hover/focus, so the row stays calm at rest but still
     announces itself as a link on approach. */
  .credit:hover,
  .credit:focus-visible {
    color: var(--deck-color-text-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .credit__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .footer__legal {
    margin: 0;
    font-size: var(--deck-font-size-label-sm);
    color: var(--deck-color-text-muted);
  }

  /* Mobile: credits stack centred and the legal line drops — matching the
     mobile mockup. */
  @media (max-width: 640px) {
    .footer {
      flex-direction: column;
      gap: var(--deck-space-8);
    }

    .footer__credits {
      flex-direction: column;
      align-items: center;
      gap: var(--deck-space-8);
    }

    .footer__legal {
      display: none;
    }
  }
</style>
