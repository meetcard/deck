---
// Storybook is published under /storybook (see netlify.toml). Ids are the real
// ones from storybook-static/index.json — Storybook does not resolve bare
// prefixes, so each of these points at a concrete first entry in its section.
// Ordered largest-to-smallest, as in the mockups.
//
// Icon geometry is shared with the Storybook sidebar via atomicKindIcons, so
// a Molecule looks the same in both places.
import { atomicKindIcons, type AtomicKind } from '../../foundations/icons/atomicKind'

const blocks: ReadonlyArray<{ label: string; href: string; kind: AtomicKind }> = [
  { label: 'Organisms', href: '/storybook/?path=/docs/build-organisms-appbar--docs', kind: 'organism' },
  { label: 'Molecules', href: '/storybook/?path=/docs/build-molecules-attendeelist--docs', kind: 'molecule' },
  { label: 'Atoms', href: '/storybook/?path=/docs/build-atoms-avatar--docs', kind: 'atom' },
]
---

<section class="blocks" aria-labelledby="blocks-heading">
  <div class="blocks__rule" aria-hidden="true"></div>

  <div class="blocks__body">
    <h2 class="blocks__heading" id="blocks-heading">Building blocks</h2>

    <ul class="blocks__list">
      {
        blocks.map((block) => (
          <li>
            <a class="pill" href={block.href}>
              <svg
                class="pill__icon"
                viewBox={atomicKindIcons[block.kind].viewBox}
                aria-hidden="true"
                focusable="false"
              >
                {atomicKindIcons[block.kind].shapes.map((shape) =>
                  shape.kind === 'circle' ? (
                    <circle cx={shape.cx} cy={shape.cy} r={shape.r} />
                  ) : (
                    <rect
                      x={shape.x}
                      y={shape.y}
                      width={shape.width}
                      height={shape.height}
                      rx={shape.rx}
                    />
                  ),
                )}
              </svg>
              {block.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="blocks__rule" aria-hidden="true"></div>
</section>

<style>
  .blocks {
    display: flex;
    align-items: center;
    gap: var(--deck-space-24);
    width: 100%;
  }

  /* The hairlines either side of the pill row. They flex to fill whatever the
     centre column leaves, so the group stays centred at any width. */
  .blocks__rule {
    flex: 1;
    height: 1px;
    background-color: var(--deck-color-border-default);
  }

  .blocks__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--deck-space-12);
  }

  .blocks__heading {
    margin: 0;
    font-size: var(--deck-font-size-label-xs);
    font-weight: var(--deck-font-weight-semibold);
    letter-spacing: var(--deck-tracking-caps);
    text-transform: uppercase;
    color: var(--deck-color-text-muted);
  }

  .blocks__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--deck-space-10);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--deck-space-8);
    padding: var(--deck-space-8) var(--deck-space-16);
    border: 1px solid var(--deck-color-border-default);
    border-radius: var(--deck-radius-full);
    background-color: var(--deck-color-background-elevated);
    color: var(--deck-color-text-default);
    font-size: var(--deck-font-size-label-md);
    font-weight: var(--deck-font-weight-medium);
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease, transform 150ms ease;
  }

  .pill:hover {
    border-color: var(--deck-color-border-brand);
    color: var(--deck-color-text-brand);
  }

  .pill__icon {
    width: 14px;
    height: 14px;
    fill: var(--deck-color-solid-brand);
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pill:hover {
      transform: translateY(-1px);
    }
  }

  /* The mockup drops the rules on mobile and lets the pills wrap. */
  @media (max-width: 640px) {
    .blocks__rule {
      display: none;
    }

    .blocks__list {
      gap: var(--deck-space-8);
    }

    .pill {
      padding: var(--deck-space-8) var(--deck-space-12);
      font-size: var(--deck-font-size-label-sm);
    }

    /* The mobile mockup drops the pill icons — text only at this width. */
    .pill__icon {
      display: none;
    }
  }
</style>
