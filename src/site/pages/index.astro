---
import Layout from '../layouts/Layout.astro'
import { NavigationGrid } from '../components/NavigationGrid'

const deckLogo = `<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="4">
  <path d="M20 30 L50 50 L80 30 L80 70 Q80 85 65 85 L35 85 Q20 85 20 70 Z" fill="currentColor" />
</svg>`
---

<Layout title="Welcome to Deck" description="MeetCard's flagship React design system">
  <div class="container">
    <div class="content">
      <div class="logo" set:html={deckLogo} />

      <div class="header">
        <h1>Welcome to Deck</h1>
        <div class="tagline">MeetCard's flagship React design system</div>
      </div>

      <p class="description">
        Deck is a composable foundation of accessible, production-ready components
        for building card-centric experiences.
      </p>

      <a href="/iframe.html?id=build-atoms" class="cta-button">
        Explore Components
      </a>

      <NavigationGrid client:load />

      <div class="footer">
        Built with React 19 + TypeScript • Accessible • Production-ready
      </div>
    </div>
  </div>

  <style>
    .container {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-24);
    }

    .content {
      max-width: 600px;
      display: flex;
      flex-direction: column;
      gap: var(--space-32);
      align-items: center;
      text-align: center;
    }

    .logo {
      width: 120px;
      height: 120px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .logo :global(svg) {
      width: 100%;
      height: 100%;
    }

    .header {
      display: flex;
      flex-direction: column;
      gap: var(--space-12);
    }

    h1 {
      font-size: 48px;
      font-weight: 600;
      line-height: 1.2;
    }

    .tagline {
      font-size: 20px;
      color: var(--color-text-muted);
    }

    .description {
      font-size: 16px;
      color: var(--color-text-muted);
      line-height: 1.8;
    }

    .nav-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: var(--space-16);
      width: 100%;
      margin-top: var(--space-16);
    }

    .nav-link {
      padding: var(--space-12) var(--space-16);
      border-radius: var(--radius-lg);
      border: 1px solid var(--color-border);
      text-decoration: none;
      color: var(--color-text);
      font-size: 14px;
      font-weight: 500;
      transition: all 200ms ease;
      background-color: transparent;
    }

    .nav-link:hover {
      border-color: var(--color-accent);
      background-color: var(--color-bg-subtle);
      color: var(--color-accent);
    }

    .cta-button {
      padding: var(--space-12) var(--space-24);
      border-radius: var(--radius-lg);
      background-color: var(--color-accent);
      color: #faf8f4;
      text-decoration: none;
      font-size: 16px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      transition: background-color 200ms ease;
      display: inline-block;
    }

    .cta-button:hover {
      background-color: var(--color-accent-hover);
    }

    .footer {
      font-size: 14px;
      color: var(--color-text-muted);
      margin-top: var(--space-16);
    }
  </style>
</Layout>
