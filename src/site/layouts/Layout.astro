---
interface Props {
  title?: string
  description?: string
}

const {
  title = 'Deck Design System by MeetCard',
  description = 'The design system behind MeetCard. Accessible, composable components for card-centric experiences.',
} = Astro.props

// Deck's token layers. Everything on this page is built from the semantic
// layer, which is also what makes dark mode work: the mockups are light-only,
// but the semantic tokens already resolve for both schemes.
import '../../styles/deck.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: var(--deck-font-sans);
        background-color: var(--deck-color-background-default);
        color: var(--deck-color-text-default);
        -webkit-font-smoothing: antialiased;
      }

      :focus-visible {
        outline: 2px solid var(--deck-color-border-focus);
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
