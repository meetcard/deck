---
interface Props {
  title?: string
  description?: string
}

const {
  title = 'Deck Design System for MeetCard',
  description = 'The design system behind MeetCard. Accessible, composable components for card-centric experiences.',
} = Astro.props

// Deck's token layers. Everything on this page is built from the semantic
// layer, which is also what makes dark mode work: the mockups are light-only,
// but the semantic tokens already resolve for both schemes.
import '../../styles/deck.css'

// Absolute, per the Open Graph spec — scrapers do not resolve relative paths.
// Astro.site comes from `site` in astro.config.mjs.
const ogImage = new URL('/og-image.png', Astro.site)
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>

    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Deck Design System" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta
      property="og:image:alt"
      content="Deck Design System — Build with Deck. Accessible, card-centric UI library designed for clean and highly composable digital experiences."
    />

    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: var(--deck-font-sans);
        background-color: var(--deck-color-background-default);
        color: var(--deck-color-text-default);
        -webkit-font-smoothing: antialiased;
      }

      :focus-visible {
        outline: 2px solid var(--deck-color-border-focus);
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
